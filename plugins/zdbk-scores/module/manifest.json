{
  "type": "module",
  "id": "zdbk-scores",
  "name": "成绩",
  "description": "zdbk-modle 模板（modle_route: score）——成绩单 / 主修成绩 / 二三四课堂，数据来自数据中心 orch://zdbk_*（需安装 data-zdbk 插件）。字段映射由 dataSources.*.bindings 声明，渲染层不再写死键名。",
  "icon": "score",
  "route": "/zdbk-scores",
  "version": "1.0.0",
  "template": "zdbk",
  "modle_route": "score",
  "dataSources": {
    "transcript": {
      "endpoint": "orch://zdbk_transcript",
      "bindings": {
        "items": "items",
        "courseName": "kcmc",
        "score": "cj",
        "gpa": "jd",
        "credit": "xf",
        "courseNo": "xkkh"
      }
    },
    "major_grade": {
      "endpoint": "orch://zdbk_major_grade",
      "bindings": {
        "items": "items",
        "courseName": "kcmc",
        "score": "cj",
        "gpa": "jd",
        "credit": "xf",
        "courseNo": "xkkh"
      }
    },
    "practice_scores": {
      "endpoint": "orch://zdbk_practice_scores",
      "bindings": {
        "pt2": "pt2",
        "pt3": "pt3",
        "pt4": "pt4"
      }
    }
  },
  "nav": {
    "sidebar": {
      "section": "学习",
      "order": 50
    }
  }
}
