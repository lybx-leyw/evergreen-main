{
  "name": "showcase_positional",
  "description": "🎭 展示工具(positional模式) — 纯位置参数，写操作(串行)。模拟一个趣味笔记生成器，将内容写入工作区。支持 --data-port 从数据源获取格言丰富笔记。",
  "schema": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string",
        "description": "文件名(不含扩展名)"
      },
      "topic": {
        "type": "string",
        "description": "笔记主题"
      },
      "mood": {
        "type": "string",
        "description": "心情标签",
        "enum": ["excited", "calm", "curious", "tired"]
      }
    },
    "required": ["filename", "topic"]
  },
  "readOnly": false,
  "argMode": "args",
  "argSpec": {
    "style": "positional",
    "prefix": "-",
    "order": ["filename", "topic", "mood"]
  },
  "extraArgs": ["--data-port"]
}
