{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "ecard",
  "name": "一卡通",
  "description": "一卡通——校园卡余额查询（elife SSO）",
  "icon": "credit_card",
  "route": "/ecard",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "校园",
      "sectionOrder": 50,
      "order": 50,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "ecard_page",
      "label": "💳 一卡通",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "main": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": false,
                "sortable": false,
                "title": "校园卡",
                "dataSource": {
                  "name": "ecard",
                  "endpoint": "/api/ecard",
                  "dataPath": "cards",
                  "refreshInterval": 300
                },
                "columns": [
                  { "key": "card_name", "label": "卡名" },
                  { "key": "balance", "label": "余额(元)" },
                  { "key": "account", "label": "账号" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
