{
  "name": "password_gen",
  "description": "随机密码生成器。可指定长度、是否包含大小写字母/数字/符号。",
  "schema": {
    "type": "object",
    "properties": {
      "length": { "type": "integer", "description": "密码长度，默认 16" },
      "uppercase": { "type": "boolean", "description": "包含大写字母，默认 true" },
      "lowercase": { "type": "boolean", "description": "包含小写字母，默认 true" },
      "digits": { "type": "boolean", "description": "包含数字，默认 true" },
      "symbols": { "type": "boolean", "description": "包含特殊符号，默认 true" },
      "count": { "type": "integer", "description": "生成数量，默认 1" }
    },
    "required": []
  },
  "readOnly": true,
  "argMode": "args",
  "argSpec": { "style": "flag", "prefix": "--", "flags": { "length": "-l", "uppercase": "-u", "lowercase": "-w", "digits": "-d", "symbols": "-s", "count": "-c" } }
}
