{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "pintia",
  "name": "PTA",
  "description": "拼题A 题目集列表（Cookie 登录，导入待办）",
  "icon": "code",
  "route": "/pintia-login",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "校园",
      "sectionOrder": 20,
      "order": 10,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "pintia_page",
      "label": "🧩 题目集",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "list": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": true,
                "sortable": true,
                "title": "PTA 题目集",
                "dataSource": {
                  "name": "problem_sets",
                  "endpoint": "/api/pintia/problem-sets",
                  "dataPath": "problemSets",
                  "refreshInterval": 3600
                },
                "columns": [
                  { "key": "title", "label": "题集名" },
                  { "key": "problemCount", "label": "题目数" },
                  { "key": "submissionCount", "label": "提交数" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
