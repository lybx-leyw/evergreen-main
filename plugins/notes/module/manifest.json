{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "notes",
  "name": "AI笔记",
  "description": "AI 笔记——对话式记录与整理学习笔记",
  "icon": "note_alt",
  "route": "/notes",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "AI 工具",
      "sectionOrder": 20,
      "order": 20,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "notes_page",
      "label": "📒 AI 笔记",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "main": {
            "component": {
              "type": "ai-assistant",
              "config": {
                "preset": "notes",
                "system_prompt": "你是学生的 AI 笔记助手。帮助用户记录、整理、归纳学习笔记：提炼要点、生成大纲、补充例题，并保持结构化。用中文回复。",
                "multi_session": true,
                "global_memory": true,
                "tools": { "mode": "specific", "allowed": ["write_file", "read_global_memory", "write_global_memory", "web_search"] }
              }
            }
          }
        }
      }
    }
  ]
}
