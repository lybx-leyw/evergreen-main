{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "library",
  "name": "图书馆",
  "description": "在借图书与到期状态",
  "icon": "local_library",
  "route": "/library",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "校园",
      "sectionOrder": 30,
      "order": 20,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "list_page",
      "label": "📚 在借图书",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "list": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": true,
                "sortable": true,
                "title": "在借图书",
                "dataSource": {
                  "name": "library_books",
                  "endpoint": "/api/library/books",
                  "dataPath": "books",
                  "refreshInterval": 600
                },
                "columns": [
                  { "key": "title", "label": "书名" },
                  { "key": "author", "label": "作者" },
                  { "key": "borrowDate", "label": "借出日期" },
                  { "key": "dueDate", "label": "应还日期" },
                  { "key": "statusLabel", "label": "状态" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
