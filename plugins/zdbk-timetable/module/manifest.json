{
  "type": "module",
  "id": "zdbk-timetable",
  "name": "课表",
  "description": "zdbk-modle 模板（modle_route: timetable）——课表，数据来自数据中心 orch://zdbk_timetable（需安装 data-zdbk 插件）。字段映射由 dataSources.timetable.bindings 声明（含 kcb blob 与 kbList 列表根键）。",
  "icon": "calendar_month",
  "route": "/zdbk-timetable",
  "version": "1.0.0",
  "template": "zdbk",
  "modle_route": "timetable",
  "dataSources": {
    "timetable": {
      "endpoint": "orch://zdbk_timetable",
      "bindings": {
        "items": "kbList",
        "kcb": "kcb",
        "courseName": "kcmc",
        "weekday": "xqj",
        "term": "xxq",
        "courseNo": "xkkh"
      }
    }
  },
  "nav": {
    "sidebar": {
      "section": "校园",
      "order": 30
    }
  }
}
