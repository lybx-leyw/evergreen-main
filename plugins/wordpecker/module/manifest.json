{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "wordpecker",
  "name": "背词",
  "description": "闪卡背词（间隔重复复习）",
  "icon": "spellcheck",
  "route": "/wordpecker",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "AI 工具",
      "sectionOrder": 20,
      "order": 60,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "review_page",
      "label": "🃏 闪卡复习",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "main": {
            "component": {
              "type": "flashcards",
              "config": {
                "wordList": "words.json",
                "algorithm": "spaced-repetition",
                "showHint": true,
                "autoFlip": false
              }
            }
          }
        }
      }
    }
  ]
}
