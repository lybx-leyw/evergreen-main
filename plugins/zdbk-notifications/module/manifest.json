{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "zdbk-notifications",
  "name": "教务通知",
  "description": "教务通知公告列表",
  "icon": "campaign",
  "route": "/zdbk-notifications",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "校园",
      "sectionOrder": 30,
      "order": 15,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "list_page",
      "label": "📢 教务通知",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "list": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": true,
                "sortable": true,
                "title": "教务通知",
                "dataSource": {
                  "name": "zdbk_notifications",
                  "endpoint": "/api/zdbk-notifications/list",
                  "dataPath": "notifications",
                  "refreshInterval": 600
                },
                "columns": [
                  { "key": "title", "label": "标题" },
                  { "key": "publisher", "label": "发布人" },
                  { "key": "publishDate", "label": "发布时间" },
                  { "key": "viewCount", "label": "浏览人数" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
