{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "exams",
  "name": "考试",
  "description": "考试日程列表与按日期视图",
  "icon": "event",
  "route": "/exams",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "学习",
      "sectionOrder": 10,
      "order": 70,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "list_page",
      "label": "📋 考试列表",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "list": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": true,
                "sortable": true,
                "title": "考试日程",
                "dataSource": {
                  "name": "exams",
                  "endpoint": "/api/exams/list",
                  "dataPath": "exams",
                  "refreshInterval": 600
                },
                "columns": [
                  { "key": "name", "label": "课程" },
                  { "key": "date", "label": "日期" },
                  { "key": "time", "label": "时间" },
                  { "key": "location", "label": "考场" },
                  { "key": "seatNumber", "label": "座位号" },
                  { "key": "urgency", "label": "紧急度" },
                  { "key": "daysUntil", "label": "剩余天数" }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "bydate_page",
      "label": "📅 按日期",
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "bydates": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": true,
                "sortable": true,
                "title": "按日期排列的考试（日历视图替代）",
                "dataSource": {
                  "name": "exams",
                  "endpoint": "/api/exams/list",
                  "dataPath": "exams",
                  "refreshInterval": 600
                },
                "columns": [
                  { "key": "date", "label": "日期" },
                  { "key": "name", "label": "课程" },
                  { "key": "time", "label": "时间" },
                  { "key": "location", "label": "考场" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
