{
  "schemaVersion": "2.0",
  "renderMode": "dart",
  "type": "module",
  "id": "autosign",
  "name": "自动签到",
  "description": "自动签到——courses 雷达签到轮询与自动应答",
  "icon": "how_to_reg",
  "route": "/autosign",
  "version": "2.0.0",
  "dependencies": [],
  "nav": {
    "sidebar": {
      "section": "学习",
      "sectionOrder": 30,
      "order": 90,
      "badge": false
    }
  },
  "pages": [
    {
      "id": "autosign_page",
      "label": "🖋️ 自动签到",
      "default": true,
      "layout": {
        "type": "grid",
        "preset": { "columns": 1, "gap": 0 },
        "slots": {
          "main": {
            "component": {
              "type": "data-table",
              "config": {
                "chrome": true,
                "display": "table",
                "filter": false,
                "sortable": false,
                "title": "签到日志",
                "dataSource": {
                  "name": "autosign",
                  "endpoint": "/api/autosign",
                  "dataPath": "logs",
                  "refreshInterval": 0
                },
                "columns": [
                  { "key": "time", "label": "时间" },
                  { "key": "message", "label": "状态" }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
