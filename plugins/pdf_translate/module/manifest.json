{
  "type": "module",
  "id": "pdf_translate",
  "name": "PDF 翻译",
  "description": "基于 DeepSeek API 的 PDF 文档翻译，支持中/英/日/韩/法/德/西 7 种语言互译，多文件并行翻译+队列排队，输出双语对照+单语译文 PDF",
  "icon": "translate",
  "route": "/pdf-translate",
  "nav": {
    "sidebar": { "section": "AI 工具", "sectionOrder": 10, "order": 70 }
  },
  "pages": [
    {
      "id": "main",
      "label": "翻译",
      "layout": {
        "type": "grid",
        "preset": { "columns": 1 },
        "slots": {
          "translate": {
            "component": {
              "type": "pdf-translate",
              "config": { "chrome": true }
            }
          }
        }
      }
    }
  ],
  "dependencies": []
}
