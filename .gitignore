# ============================================================
# Evergreen 项目 .gitignore（集中管理所有子目录规则）
# 子目录原 .gitignore 保留未删除，如冲突以此文件为准
# ============================================================

# ──────────────────────────────────────────────────────────
# 全局 — 编译产物 & 缓存
# ──────────────────────────────────────────────────────────
*.bak
*.class
*.log
*.err
*.pyc
*.swp
*.[Cc]ache
!*.[Cc]ache/

# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml
*.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.manifest
!evg-base/windows/runner/runner.exe.manifest
*.spec

# Go
*.exe~
*.test
*.out

# Node.js / Frontend
node_modules/
.npm
.vite/
*.tsbuildinfo

# ──────────────────────────────────────────────────────────
# 全局 — IDE & 编辑器
# ──────────────────────────────────────────────────────────
.idea/
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# JetBrains
*.sln.iml

# VS Build
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
.vs/
x64/
x86/

# ──────────────────────────────────────────────────────────
# 全局 — OS & 环境
# ──────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.atom/
.history
.svn/
.swftpm/
migrate_working_dir/
*.swp
~$*
*~

# Secrets（一律不提交）
.env
.env/
.env.*
.cookies/

# ──────────────────────────────────────────────────────────
# 全局 — AI 本地文件
# ──────────────────────────────────────────────────────────
.codebuddy
.claude
.reasonix
.claude/
.omc/
.omx/
WARP.md
**/memory-bank/
**/projectBrief.md
**/tmpclaude*
.kiro/

# ──────────────────────────────────────────────────────────
# 参考实现 / 内部交互文档 / 规划与日志（临时交互产物，不纳入版本库）
# ──────────────────────────────────────────────────────────
# 参考代码副本与 UI 参考（曾完整提交，已 rm --cached 停止追踪；磁盘保留）
.reference/
.refer_ui/

# 内部流程/规则/经验卡片（跨会话流程上下文，非源码）
.internal/

# 变更记录 / 交接日志
change_log/

# 一次性规划 / 协作入口文档（决策完成后不再有版本价值）
v5P渲染重构规划.md
CLAUDE.md

# 根目录一次性架构导出 / 构建日志 / 临时分析产物
架构示意图.html
build_output.txt
_build_zdbk.log
evg-base/tmp_analyze.txt
evg-base/tmp_*.txt
**/tmp_analyze*.txt

# 根目录一次性算法草稿 / 课表实验
课表.c
课表规划算法.md

# ──────────────────────────────────────────────────────────
# 项目根 — 构建 & 数据
# ──────────────────────────────────────────────────────────
build/
coverage/
.greenix/
.pytest_cache/
config_debug.txt
data_slot_test.txt
diff_assets_doc.txt
diff_build_py.txt
diff_build_py2.txt
diff_manifest_dart.txt
diff_manifest_html.txt
diff_manifest_v4.txt
diff_manifest_v4html.txt
diff_slot_widgets.txt
old_manifest_v4.txt

# python 打包环境 & 二进制编译产物（含源路径元数据，严禁提交）
evg-base/scripts/python/
*.dill

# 内部文件
evg-base/.history_docs
PRODUCT_DESIGN_DOCUMENT.md
AI工作台能力评估计划.md
evg-base/愿景.md
DEVELOPER_GUIDE.md
愿景.md
PLAN_NOW.md
.achieve/
prompt/
ROLES.md

# ──────────────────────────────────────────────────────────
# evg-base/ 子树规则
# ──────────────────────────────────────────────────────────

# evg-base — reference（evg-base 内部 .reference）
evg-base/.reference/

# evg-base/windows/
evg-base/windows/flutter/ephemeral/

# evg-base/lib/core/
evg-base/lib/core/example/.cache/
evg-base/lib/core/example/plugins/*/*/*.exe
evg-base/lib/core/example/plugins/*/*/*.spec
evg-base/lib/core/example/plugins/*/*/build/
evg-base/lib/core/example/plugins/*/*/dist/
evg-base/lib/core/example/plugins/*/*/__pycache__/

# 插件运行时状态（不可提交）
.plugin_states.json

# 插件目录源码进版本库（构建/运行时中间产物在 evg-base/.gitignore 排除）

# 安卓打包副本（tool/bundle_plugins.dart 从 evg-base/plugins/ 生成）
evg-base/assets/plugins_bundle/

# evg-base — 运行时 debug / 临时输出文件（含绝对路径，严禁提交）
**/._debug.txt
evg-base/analyze_*.txt
evg-base/*_output.txt
# evg-base — 工具脚本整体忽略，仅放行 CI 需要的 bundle_plugins.dart
# （其余 tool/ 脚本为本地开发辅助，不需要进版本库）
evg-base/tool/*
!evg-base/tool/bundle_plugins.dart
analyze_*.txt
_*.txt
build_*.txt
test_*.txt

# evg-base — 运行时端口文件（App 启动时自动写入，严禁提交）
evg-base/.*_port

# evg-base/lib/renderer/
evg-base/lib/renderer/docs/output/

# evg-base/lib/core/agent/
evg-base/lib/core/agent/example/.dart_tool
evg-base/lib/core/agent/example/pubspec.lock
evg-base/lib/core/agent/example/plugins/**/*.exe
evg-base/lib/core/agent/example/plugins/**/*.spec
evg-base/lib/core/agent/example/plugins/**/build/
evg-base/lib/core/agent/example/plugins/**/dist/
evg-base/lib/core/agent/example/plugins/**/__pycache__/

# evg-base/lib/core/data/
evg-base/lib/core/data/.dart_test.yaml
evg-base/lib/core/data/test/.cache/
evg-base/lib/core/data/example/.cache/
evg-base/lib/core/data/example/plugins/douban/build
evg-base/lib/core/data/example/plugins/douban/dist
evg-base/lib/core/data/example/plugins/douban/*.spec
evg-base/lib/core/data/example/plugins/douban/data/plugin.exe

# evg-base/lib/core/module/
evg-base/lib/core/module/example/.cache/
evg-base/lib/core/module/example/plugins/*/build
evg-base/lib/core/module/example/plugins/*/dist
evg-base/lib/core/module/example/plugins/*/*.spec
evg-base/lib/core/module/example/plugins/*/*.exe

# evg-base/lib/core/theme/
evg-base/lib/core/theme/example/.cache/

# evg-base/lib/core/config/
# (.claude / .dart_tool / pubspec.lock 已被全局规则覆盖，无需重复)

