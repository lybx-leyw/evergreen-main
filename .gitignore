# ============================================================
# Evergreen 项目 .gitignore（集中管理所有子目录规则）
# 子目录原 .gitignore 保留未删除，如冲突以此文件为准
# ============================================================

# ──────────────────────────────────────────────────────────
# 全局 — 编译产物 & 缓存
# ──────────────────────────────────────────────────────────
*.bak
*.class
*.log
*.pyc
*.swp
*.[Cc]ache
!*.[Cc]ache/

# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml
*.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.manifest
*.spec

# Go
*.exe~
*.test
*.out

# Node.js / Frontend
node_modules/
.npm
.vite/
*.tsbuildinfo

# ──────────────────────────────────────────────────────────
# 全局 — IDE & 编辑器
# ──────────────────────────────────────────────────────────
.idea/
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# JetBrains
*.sln.iml

# VS Build
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
.vs/
x64/
x86/

# ──────────────────────────────────────────────────────────
# 全局 — OS & 环境
# ──────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.atom/
.history
.svn/
.swftpm/
migrate_working_dir/
*.swp
~$*
*~

# Secrets（一律不提交）
.env
.env/
.env.*
.cookies/

# ──────────────────────────────────────────────────────────
# 全局 — AI 本地文件
# ──────────────────────────────────────────────────────────
.codebuddy
.claude
.claude/
.omc/
.omx/
WARP.md
**/memory-bank/
**/projectBrief.md
**/tmpclaude*
.kiro/

# ──────────────────────────────────────────────────────────
# 项目根 — 构建 & 数据
# ──────────────────────────────────────────────────────────
build/
coverage/
.greenix/
.pytest_cache/

# python 打包环境 & 二进制编译产物（含源路径元数据，严禁提交）
evg-base/scripts/python/
*.dill

# 内部文件
evg-base/.history_docs
evg-base/愿景.md
DEVELOPER_GUIDE.md
愿景.md
PLAN_NOW.md
.achieve/
prompt/
ROLES.md

# ──────────────────────────────────────────────────────────
# evg-base/ 子树规则
# ──────────────────────────────────────────────────────────

# evg-base — reference（evg-base 内部 .reference）
evg-base/.reference/

# evg-base/windows/
evg-base/windows/flutter/ephemeral/

# evg-base/lib/core/
evg-base/lib/core/example/.cache/
evg-base/lib/core/example/plugins/*/*/*.exe
evg-base/lib/core/example/plugins/*/*/*.spec
evg-base/lib/core/example/plugins/*/*/build/
evg-base/lib/core/example/plugins/*/*/dist/
evg-base/lib/core/example/plugins/*/*/__pycache__/

# evg-base — 运行时 debug 文件（含绝对路径，严禁提交）
**/._debug.txt
evg-base/analyze_*.txt
evg-base/*_output.txt
evg-base/tool/
analyze_comp.txt
analyze_out.txt
analyze_out2.txt
analyze_result.txt
analyze_scraper.txt
build_out.txt
build_scraper.txt
test_output.txt
test_result.txt

# evg-base — 运行时端口文件（App 启动时自动写入，严禁提交）
evg-base/.*_port

# evg-base/lib/renderer/
evg-base/lib/renderer/docs/output/

# evg-base/lib/core/agent/
evg-base/lib/core/agent/example/.dart_tool
evg-base/lib/core/agent/example/pubspec.lock
