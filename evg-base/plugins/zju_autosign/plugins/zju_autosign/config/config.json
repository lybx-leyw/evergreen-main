        { "value": "ZJG4",  "label": "紫金港 · 大西区" },
        { "value": "YQ4",   "label": "玉泉 · 教四" },
        { "value": "YQ1",   "label": "玉泉 · 教一" },
        { "value": "YQ7",   "label": "玉泉 · 教七" },
        { "value": "YQSS",  "label": "玉泉 · 宿舍区" },
