{
  "id": "evergreen-core",
  "name": "Evergreen Core 默认设置",
  "settings": [
    {"key":"DEEPSEEK_API_KEY",     "label":"DeepSeek API Key",  "type":"string", "isSecure":true,  "hint":"从 platform.deepseek.com 获取"},
    {"key":"DEEPSEEK_MODEL",       "label":"DeepSeek 模型",     "type":"string", "default":"deepseek-v4-flash",
      "suggestions":[
        {"value":"deepseek-v4-flash","label":"V4 Flash（快速）"},
        {"value":"deepseek-v4-pro",  "label":"V4 Pro（平衡）"},
        {"value":"deepseek-v4-max",  "label":"V4 Max（最强）"},
        {"value":"deepseek-chat",    "label":"DeepSeek Chat（OpenAI 兼容）"},
        {"value":"deepseek-reasoner","label":"DeepSeek Reasoner（OpenAI 兼容）"}
      ],
      "hint":"可自由填写任意 OpenAI 兼容模型 id（配合自定义 API 地址使用），点击下方建议可快速填入"
    },
    {"key":"DEEPSEEK_BASE_URL",    "label":"API 地址",          "type":"string", "default":"https://api.deepseek.com/v1", "hint":"自定义 API 代理地址（兼容 OpenAI 格式）"},
    {"key":"DEEPSEEK_THINKING",    "label":"深度思考",           "type":"bool",   "default":"true",  "hint":"启用后 AI 会展示详细推理过程（消耗更多 token）"},
    {"key":"OUTPUT_STYLE",         "label":"输出风格",           "type":"option", "default":"explanatory",
      "options":[
        {"value":"explanatory","label":"解释型"},
        {"value":"learning",    "label":"学习型"},
        {"value":"concise",     "label":"简洁型"},
        {"value":"socratic",    "label":"苏格拉底式"}
      ],
      "hint":"AI 回复的风格偏好"
    },
    {"key":"WEB_SEARCH_ENABLED",   "label":"联网搜索",           "type":"bool",   "default":"false", "hint":"允许 AI 使用 web_search 工具查找实时信息"},
    {"key":"DEEPSEEK_OCR_API_KEY", "label":"DeepSeek OCR Key",  "type":"string", "isSecure":true,  "hint":"用于 OCR 管线的 Level 1"},
    {"key":"PYTHON_EXE",           "label":"Python 解释器路径",   "type":"path",   "hint":"默认使用内置 .greenix/python/python.exe"},
    {"key":"MATERIAL_DOWNLOAD_PATH","label":"下载目录",           "type":"path",   "hint":"素材/文件下载保存目录"},
    {"key":"ZJU_USERNAME",         "label":"浙大统一认证账号",     "type":"string", "hint":"学号（如 3230XXXXXXXX），教务/智云课堂/图书馆/一卡通共用"},
    {"key":"ZJU_PASSWORD",         "label":"浙大统一认证密码",     "type":"string", "isSecure":true, "hint":"统一认证密码，教务/智云课堂/图书馆/一卡通共用"},
    {"key":"GITHUB_FEEDBACK_TOKEN", "label":"GitHub 反馈令牌 (PAT)", "type":"string", "isSecure":true, "hint":"需 repo 权限，用于反馈面板一键提交 Issue 到 evergreen-main"}
  ]
}
