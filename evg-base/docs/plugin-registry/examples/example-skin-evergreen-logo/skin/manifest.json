{
  "type": "skin",
  "id": "example-skin-evergreen-logo",
  "name": "绿意 Logo 皮肤",
  "version": "1.0.0",
  "description": "示例皮肤包：绿意不息 logo + 绿意对话背景（A1）+ 按钮显隐（B1）+ 思考栏配色（C1）演示",

  "assets": {
    "logoDesktop": "logo_desktop.svg",
    "logoMobile": "logo_mobile.svg"
  },

  "background": {
    "type": "gradient",
    "gradient": { "from": "#E8F5E9", "to": "#FFFFFF", "angle": 135 }
  },

  "buttons": {
    "inputBar": {
      "workspace": true,
      "webSearch": true,
      "thinkingEffort": true,
      "tools": true,
      "bgProcess": false,
      "skills": true,
      "clear": true
    },
    "messageActions": {
      "copy": true,
      "regenerate": true,
      "edit": true
    }
  },

  "thinking": {
    "title": "思考过程",
    "colors": {
      "header": "#1B8A4F",
      "containerBackground": "#F0F9F2",
      "contentText": "#3E7C55",
      "chipMemoryBg": "#E8F5E9",
      "chipMemoryFg": "#1B5E20",
      "chipSkillBg": "#E0F2F1",
      "chipSkillFg": "#00695C",
      "chipToolBg": "#E3F2FD",
      "chipToolFg": "#1565C0",
      "chipToolResultBg": "#E8F5E9",
      "chipToolResultFg": "#1B5E20"
    }
  },

  "bubble": {
    "userBackgroundColor": "#DCEDC8",
    "userTextColor": "#33691E",
    "borderRadius": 18,
    "maxWidthRatio": 0.72
  },

  "avatar": {
    "userBackgroundColor": "#C8E6C9",
    "assistant": "logo_mobile.svg"
  },

  "emptyState": {
    "logo": "logo_desktop.svg",
    "title": "我是你的绿意 AI 助手"
  },

  "effortColor": "#0F9D58",
  "toolActiveColor": "#0F9D58"
}
