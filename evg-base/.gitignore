# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
*.lock

# IDE
.idea/
.vscode/
*.suo
*.user
*.userosscache

# Greenix 运行时数据（sessions/memories/skills/workspaces/python）
.greenix/

# 插件目录：源码进版本库；仅排除构建/运行时中间产物与敏感文件
plugins/**/__pycache__/
plugins/**/*.pyc
plugins/**/*.exe
plugins/**/render_log.html
plugins/**/*.data_port

# OS
.DS_Store
Thumbs.db

# Reference
.reference

# 测试用假反馈数据（截图为自己截的，非真实用户反馈）
test/feedback/

# Agent 运行时数据（本次会话产物：分析输出/截断结果缓存）
.reasonix/

# 构建/运行日志归档（D7 起根目录不再堆放日志）
logs-archive/

# 会话分析临时文件
[cd]_analyze*.txt
[cd]?_analyze*.txt
# D 系列分析输出（d7_analyze.txt 等，前缀含数字时上述模式不命中）
d[0-9]*_analyze*.txt
d[0-9]*_analyze*_*.txt

# 根目录一次性分析脚本（含本机绝对路径，非仓库资产）
/analyze_png.py
/ascii_view.py
/density_map.py
/count_core_lines.py

# NuGet CLI 二进制（构建工具，官方随时可下载：https://dist.nuget.org）
/nuget.exe