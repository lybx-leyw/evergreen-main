    {"key":"DEEPSEEK_MODEL",       "label":"DeepSeek 模型",     "type":"string", "default":"deepseek-v4-flash"},
    {"key":"DEEPSEEK_THINKING",    "label":"深度思考",           "type":"bool",   "default":"true"},
    {"key":"DEEPSEEK_OCR_API_KEY", "label":"DeepSeek OCR Key",  "type":"string", "isSecure":true,  "hint":"用于 OCR 管线的 Level 1"},
    {"key":"PYTHON_EXE",           "label":"Python 解释器路径",   "type":"path",   "hint":"默认使用内置 scripts/python/python.exe"},
    {"key":"MATERIAL_DOWNLOAD_PATH","label":"下载目录",           "type":"path"}
